{
  "name": "mobile-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && node deploy.cjs",
    "cap:sync": "npm run build && node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:copy": "node ./node_modules/@capacitor/cli/bin/capacitor copy android",
    "cap:assets": "capacitor-assets generate --android --splashBackgroundColor \"#0a0f1d\" --splashBackgroundColorDark \"#0a0f1d\""
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capgo/capacitor-updater": "^8.51.4"
  }
}
